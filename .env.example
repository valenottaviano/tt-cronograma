# Firebase — contenido público del sitio (carreras, productos, tracks, beneficios,
# pedidos) y login del admin. Todas son NEXT_PUBLIC: llegan al navegador.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Sheets publicados como CSV
# (GOOGLE_SHEET_CSV_URL es el nombre viejo de RACES: sigue funcionando como fallback)
GOOGLE_SHEET_RACES_URL=
GOOGLE_SHEET_BENEFITS_URL=
GOOGLE_SHEET_NEWS_URL=

# Backend del coach (roberto-parodi). Server-only: nunca usar prefijo NEXT_PUBLIC.
# Ej: https://plan.grupott.com.ar
COACH_API_URL=

# Secreto compartido para POST /api/v1/public/applications (flujo /sumate).
# Debe coincidir con PUBLIC_API_KEY del lado de roberto-parodi.
# Generar con: openssl rand -hex 32
COACH_PUBLIC_API_KEY=

# Clave de cifrado de la cookie de sesión del atleta (iron-session), mín. 32 chars.
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# App de comercios (tt-comercios). Es el destino del QR de la credencial del
# alumno. Es NEXT_PUBLIC porque el QR se arma en el navegador.
# Si queda vacía, el QR cae en /card/[dni] de este mismo sitio.
# Ej: https://comercios.grupott.com.ar
NEXT_PUBLIC_COMERCIOS_URL=

# Panel del coach, para enlazar desde el admin a la gestión de comercios.
# Ej: https://plan.grupott.com.ar
NEXT_PUBLIC_COACH_PANEL_URL=
